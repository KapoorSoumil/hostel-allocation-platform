prisma:query SELECT "public"."rooms"."id", "public"."rooms"."hostel_block_id", "public"."rooms"."category_id", "public"."rooms"."room_number", "public"."rooms"."floor", "public"."rooms"."capacity", "public"."rooms"."current_occupancy", "public"."rooms"."is_available", "public"."rooms"."created_at", "public"."rooms"."updated_at" FROM "public"."rooms" WHERE "public"."rooms"."hostel_block_id" IN ($1,$2,$3) OFFSET $4
prisma:query SELECT "public"."rooms"."id", "public"."rooms"."hostel_block_id", "public"."rooms"."category_id", "public"."rooms"."room_number", "public"."rooms"."floor", "public"."rooms"."capacity", "public"."rooms"."current_occupancy", "public"."rooms"."is_available", "public"."rooms"."created_at", "public"."rooms"."updated_at" FROM "public"."rooms" LEFT JOIN "public"."hostel_blocks" AS "orderby_1" ON ("orderby_1"."id") = ("public"."rooms"."hostel_block_id") WHERE 1=1 ORDER BY "orderby_1"."name" ASC, "public"."rooms"."room_number" ASC OFFSET $1
