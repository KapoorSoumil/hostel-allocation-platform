prisma:query SELECT "public"."hostel_blocks"."id", "public"."hostel_blocks"."name", "public"."hostel_blocks"."gender"::text, "public"."hostel_blocks"."description", "public"."hostel_blocks"."total_rooms", "public"."hostel_blocks"."is_active", "public"."hostel_blocks"."created_at", "public"."hostel_blocks"."updated_at" FROM "public"."hostel_blocks" WHERE 1=1 ORDER BY "public"."hostel_blocks"."name" ASC OFFSET $1
prisma:query SELECT "public"."allocations"."id", "public"."allocations"."room_id", "public"."allocations"."student_id", "public"."allocations"."allocated_by_user_id", "public"."allocations"."allocation_group_id", "public"."allocations"."created_at" FROM "public"."allocations" WHERE 1=1 ORDER BY "public"."allocations"."created_at" DESC OFFSET $1
